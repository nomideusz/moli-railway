{
	admin off
	auto_https off
}

:{$PORT} {
	# Railway healthcheck, no token needed.
	handle /health {
		rewrite * /status
		reverse_proxy 127.0.0.1:9222
	}

	@authed expression `{header.Authorization} == "Bearer {$MOLI_TOKEN}" || {header.Authorization} == "Basic {$MOLI_BASIC}" || {query.token} == "{$MOLI_TOKEN}"`

	handle @authed {
		# Moli advertises ws://127.0.0.1:9222; hand CDP clients the public URL instead.
		@version path /json/version /json/version/
		route {
			respond @version `{"Browser":"Chrome/145.0.0.0","Protocol-Version":"1.3","webSocketDebuggerUrl":"{ws}://{hostport}/devtools/browser/moli-browser{wsq}"}`
			uri query -token
			reverse_proxy 127.0.0.1:9222
		}
	}

	handle {
		respond "Unauthorized: send Authorization: Bearer <MOLI_TOKEN> or ?token=<MOLI_TOKEN>" 401
	}

	map {header.X-Forwarded-Proto} {ws} {
		https wss
		default ws
	}
	map {query.token} {wsq} {
		"" ""
		default ?token={query.token}
	}
}
