#!/bin/bash
set -e
if [ ${#MOLI_TOKEN} -lt 16 ]; then echo "MOLI_TOKEN must be at least 16 characters" >&2; exit 1; fi
# Basic auth for WebDriver clients: https://moli:<token>@host/
export MOLI_BASIC=$(printf 'moli:%s' "$MOLI_TOKEN" | base64 -w0)
export PORT=${PORT:-8080}
# Moli itself has no auth, so it only listens on loopback; Caddy checks the token.
moli serve --host 127.0.0.1 --port 9222 --block-private-networks $MOLI_ARGS &
caddy run --config /etc/caddy/Caddyfile --adapter caddyfile &
wait -n
exit 1
